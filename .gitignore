signing.properties
google-services.json

# ── APK: 심사용 release APK(/apk/)만 올린다 ──
*.apk
*.aab
!/apk/*.apk
output-metadata.json

# ── IDE·OS ──
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# ── 로그·덤프 ──
*.log
*.hprof

# ── 문서: 저장소 README만 올리고, 기획 초안·원고·점검용 메모는 올리지 않는다 ──
*.md
!/README.md
