/build/
/app/build/
.gradle/
.kotlin/
/captures/
.externalNativeBuild/
.cxx/

# ── 로컬 설정·비밀 값 (SDK 경로, 카카오 API 키, 서명 정보) ──
local.properties
*.keystore
*.jks
